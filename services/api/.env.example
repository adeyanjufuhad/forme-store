# Copy a Neon pooled connection string. Keep sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.neon.tech/neondb?sslmode=require
PORT=8080
API_HOST=127.0.0.1
WEB_ORIGIN=http://127.0.0.1:3000
# Explicit local demo mode; orders stay in memory and reset on restart.
# Leave DATABASE_URL empty and set DEMO_MODE=true to preview without Neon.
DEMO_MODE=false
